#!/bin/bash
#
# Author: James Kreiss, <james@jameskress.com>
#
#SBATCH --account=k01
#SBATCH --job-name=gs.shaheen
#SBATCH --output=gsShaheen.%j.out
#SBATCH --error=gsShaheen.%j.out
#SBATCH --partition=workq
#SBATCH --nodes=256
#SBATCH --mem=0
#SBATCH --time=1:00:00

# load the environment
source ../../sites/shaheen/MODULES.sh


#OpenMP settings:
export OMP_NUM_THREADS=4

echo "Running Gray-scott"
time srun --hint=nomultithread --ntasks=4096 --ntasks-per-node=16 --ntasks-per-socket=8 --cpus-per-task=4 --ntasks-per-core=1 --mem-bind=v,local --cpu-bind=threads ../gray-scott --settings-file=settings-ascent.json --logging-level=INFO 

date
echo "Run finished"
